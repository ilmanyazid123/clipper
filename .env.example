# Database Neon Postgres
# Runtime (pooled via pgbouncer — direkomendasikan untuk serverless/Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true
# DDL (prisma db push / migrate — koneksi langsung tanpa pooler)
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# Seed akun admin (scripts/seed-admin.ts)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_CREDITS=100
